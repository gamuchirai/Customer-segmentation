# Secrets and local agent tooling
.env
.env.*
/.agents

# Raw datasets (downloaded manually; keep folder tracked)
dataset/*.xlsx
dataset/*.xls
dataset/*.csv
dataset/*.zip

# Local SQLite databases and WAL artifacts
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Generated BI exports (keep folder tracked)
exports/*
!exports/.gitkeep

# Python environments, bytecode, and tool caches
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.ty_cache/
.coverage
htmlcov/

# Power BI temporary and lock files
~*.pbix
*.pbix.bak

# Jupyter checkpoints
.ipynb_checkpoints/

# OS artifacts
.DS_Store
Thumbs.db


